# =============================================================================
# Локально: скопируйте в server/.env и заполните значения
# Render: те же переменные — в Dashboard → Environment (файл .env не нужен)
# =============================================================================

# --- Обязательно на Render, опционально локально ---
# Без DATABASE_URL локально работает in-memory БД (данные пропадут после перезапуска).
# На Render укажите Neon/Supabase, иначе данные не сохранятся.
PORT=3000
DATABASE_URL=
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=session_token
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
AUTO_OPEN_BROWSER=0
ADMIN_PHONE=+79990000000
ADMIN_PASSWORD=Admin12345!

# --- ИИ-поддержка (заглушка — без внешних API) ---
SUPPORT_BOT_ENABLED=1
AI_PROVIDER=stub

# --- SMTP (уведомления) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Яндекс.Карты (клиент: выбор ПВЗ, админ: склад отправления) ---
YANDEX_MAPS_API_KEY=

# --- Почта России — API Отправки (https://otpravka.pochta.ru/specification) ---
POCHTA_ENABLED=1
POCHTA_OTPRAVKA_BASE_URL=https://otpravka-api.pochta.ru
POCHTA_OTPRAVKA_TOKEN=
POCHTA_OTPRAVKA_USER_AUTH=
POCHTA_OTPRAVKA_TIMEOUT_MS=30000
POCHTA_WAREHOUSE_INDEX=
POCHTA_MAIL_TYPE=POSTAL_PARCEL
POCHTA_MAIL_CATEGORY=ORDINARY
POCHTA_DIMENSION_TYPE=S
POCHTA_DEFAULT_DENSITY_G_CM3=1.24
POCHTA_MIN_WEIGHT_G=100
POCHTA_MAX_WEIGHT_G=20000

# =============================================================================
# Render (пример — подставьте свой URL сервиса):
#   NODE_ENV=production
#   CORS_ORIGIN=https://your-app.onrender.com
#   DATABASE_URL=postgresql://...neon.tech/...
#   AI_PROVIDER=stub
#   AUTO_OPEN_BROWSER=0
# =============================================================================
